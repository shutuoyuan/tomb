<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#05070d" />
<title>建筑之墓 · 凝固的音乐，永恒的夕阳</title>
<style>
  :root{ --cyan:#00fff0; --magenta:#ff2bd6; }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    min-height:100dvh;
    display:grid; place-items:center;
    background:radial-gradient(120% 80% at 50% 15%, #0a1626 0%, #05070d 52%, #010205 100%);
    font-family:"Noto Serif SC","Source Han Serif SC","Songti SC","STSong",serif;
    color:#bff; overflow:hidden; user-select:none;
    -webkit-tap-highlight-color:transparent;
  }

  /* ===== 氛围层 ===== */
  .fx{ position:fixed; inset:0; pointer-events:none; }
  .fx-grid{
    z-index:0;
    background-image:
      linear-gradient(rgba(0,255,240,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,240,.05) 1px, transparent 1px);
    background-size:44px 44px;
    -webkit-mask-image:radial-gradient(circle at 50% 45%, #000 20%, transparent 72%);
    mask-image:radial-gradient(circle at 50% 45%, #000 20%, transparent 72%);
  }
  .fx-scan{
    z-index:4; mix-blend-mode:screen;
    background:repeating-linear-gradient(to bottom,
      rgba(0,255,240,.055) 0 1px, transparent 1px 4px);
    animation:scanRoll 9s linear infinite;
  }
  @keyframes scanRoll{ from{background-position-y:0} to{background-position-y:200px} }
  .fx-sweep{
    z-index:3; height:180px;
    background:linear-gradient(to bottom, transparent, rgba(0,255,240,.07), rgba(0,255,240,.02), transparent);
    animation:sweepDown 7s cubic-bezier(.4,0,.6,1) infinite;
  }
  @keyframes sweepDown{
    0%{ transform:translateY(-200px); opacity:0; }
    12%,88%{ opacity:1; }
    100%{ transform:translateY(100dvh); opacity:0; }
  }
  .fx-vignette{
    z-index:5;
    background:radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(0,0,0,.72) 100%);
  }

  /* ===== 主体 ===== */
  .stage{
    position:relative; z-index:2;
    display:flex; flex-direction:column; align-items:center;
    padding:24px;
  }

  /* 墓碑 */
  .tomb{
    position:relative;
    width:min(80vw, 320px);
    padding:52px 24px 44px;
    border-radius:50% 50% 8px 8px / 34% 34% 0 0;
    background:linear-gradient(180deg, rgba(8,26,38,.94), rgba(3,8,15,.97));
    border:1.5px solid rgba(0,255,240,.4);
    animation:breathe 5s ease-in-out infinite;
  }
  .tomb::after{
    content:""; position:absolute; inset:7px;
    border-radius:inherit;
    border:1px solid rgba(0,255,240,.12);
    pointer-events:none;
  }
  @keyframes breathe{
    0%,100%{
      box-shadow:0 0 14px rgba(0,255,240,.30), 0 0 44px rgba(0,255,240,.12),
                 inset 0 0 26px rgba(0,255,240,.07);
    }
    50%{
      box-shadow:0 0 22px rgba(0,255,240,.55), 0 0 78px rgba(0,255,240,.24),
                 inset 0 0 38px rgba(0,255,240,.14);
    }
  }

  /* 屋顶符号 */
  .roof{
    display:block; margin:0 auto 20px;
    filter:drop-shadow(0 0 6px rgba(0,255,240,.85));
    opacity:.9;
  }

  /* 碑名 + 故障效果 */
  .glitch{
    position:relative;
    text-align:center;
    font-size:clamp(28px, 8.6vw, 42px);
    font-weight:700;
    letter-spacing:.14em;
    text-indent:.14em;
    color:#f2ffff;
    text-shadow:
      0 0 6px rgba(0,255,240,.95),
      0 0 20px rgba(0,255,240,.6),
      0 0 46px rgba(0,255,240,.35);
  }
  .glitch::before, .glitch::after{
    content:attr(data-text);
    position:absolute; left:0; top:0; width:100%;
    letter-spacing:.14em; text-indent:.14em;
    opacity:0; pointer-events:none;
  }
  .glitch::before{ color:var(--magenta); text-shadow:0 0 10px var(--magenta); animation:gTop 4.2s infinite steps(1); }
  .glitch::after { color:var(--cyan);    text-shadow:0 0 10px var(--cyan);    animation:gBot 3.4s infinite steps(1); }
  @keyframes gTop{
    0%,88%,100%{ opacity:0; transform:translate(0); }
    89%{ opacity:.9; transform:translate(-2px,-2px); clip-path:inset(0 0 58% 0); }
    92%{ opacity:.9; transform:translate(2px,-1px);  clip-path:inset(0 0 58% 0); }
    95%{ opacity:0; }
  }
  @keyframes gBot{
    0%,84%,100%{ opacity:0; transform:translate(0); }
    85%{ opacity:.85; transform:translate(2px,2px);  clip-path:inset(56% 0 0 0); }
    88%{ opacity:.85; transform:translate(-3px,1px); clip-path:inset(56% 0 0 0); }
    91%{ opacity:0; }
  }

  /* 墓志铭 */
  .epitaph{
    margin-top:18px; text-align:center;
    font-size:clamp(11px, 3.2vw, 13px);
    letter-spacing:.22em; text-indent:.22em;
    color:rgba(150,255,245,.72);
    text-shadow:0 0 12px rgba(0,255,240,.35);
    white-space:nowrap;
  }

  /* 分隔线 */
  .divider{
    display:flex; align-items:center; justify-content:center; gap:8px;
    margin-top:26px;
  }
  .divider::before, .divider::after{
    content:""; width:52px; height:1px;
    background:linear-gradient(90deg, transparent, rgba(0,255,240,.6), transparent);
  }
  .divider i{
    width:5px; height:5px; background:var(--cyan);
    transform:rotate(45deg);
    box-shadow:0 0 8px var(--cyan);
  }

  /* 计数器 */
  .counter{
    margin-top:22px; text-align:center;
    font-size:clamp(12px, 3.4vw, 14px);
    letter-spacing:.18em; text-indent:.18em;
    line-height:1.9;
    color:rgba(190,255,250,.8);
  }
  #count{
    display:inline-block;
    font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size:1.85em; font-weight:700; letter-spacing:.04em;
    color:#fff; padding:0 .1em; min-width:1.2em;
    vertical-align:-.06em;
    text-shadow:0 0 8px var(--cyan), 0 0 24px rgba(0,255,240,.85), 0 0 60px rgba(0,255,240,.4);
    transition:opacity .3s;
  }

  /* 底座与地面辉光 */
  .base{
    width:min(92vw, 380px); height:12px; margin-top:6px;
    border-radius:3px;
    background:linear-gradient(180deg, rgba(0,255,240,.35), rgba(0,255,240,.03));
    box-shadow:0 0 26px rgba(0,255,240,.35), 0 0 70px rgba(0,255,240,.12);
  }
  .floor-glow{
    width:min(70vw, 280px); height:16px; margin-top:10px;
    border-radius:50%;
    background:radial-gradient(ellipse, rgba(0,255,240,.35), transparent 70%);
    filter:blur(6px);
  }
</style>
</head>
<body>
  <div class="fx fx-grid"></div>
  <div class="fx fx-sweep"></div>
  <div class="fx fx-scan"></div>
  <div class="fx fx-vignette"></div>

  <main class="stage">
    <section class="tomb">
      <svg class="roof" viewBox="0 0 64 32" width="52" height="26" aria-hidden="true">
        <path d="M4 28 L32 6 L60 28" fill="none" stroke="#00fff0" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M32 6 V28" stroke="#00fff0" stroke-width="1" opacity=".45"/>
      </svg>

      <h1 class="glitch" data-text="建筑之墓">建筑之墓</h1>
      <p class="epitaph">（凝固的音乐，永恒的夕阳）</p>

      <div class="divider"><i></i></div>

      <p class="counter">
        你是第 <span id="count">—</span> 个<br>给建筑扫墓的人
      </p>
    </section>

    <div class="base"></div>
    <div class="floor-glow"></div>
  </main>

<script>
(function () {
  /* ========== 计数接口配置 ========== */
  const API_BASE   = 'https://abacus.jasoncameron.dev';
  const COUNT_KEY  = 'archgrave-2024/visits';   // ← 改成你自己的命名空间/键名
  const STORE_FLAG = 'archgrave_counted_v1';    // 本地去重标记

  const countEl = document.getElementById('count');

  /* 数字滚动动画 */
  function roll(el, target) {
    const from = Math.max(0, target - 12);
    const t0 = performance.now(), dur = 900;
    (function tick(t) {
      const p = Math.min(1, (t - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(from + (target - from) * e).toLocaleString();
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = target.toLocaleString();
    })(t0);
  }

  /* 同一设备只计一次，刷新只读取不自增 */
  const already = localStorage.getItem(STORE_FLAG) === '1';
  const url = `${API_BASE}/${already ? 'get' : 'hit'}/${COUNT_KEY}`;

  fetch(url, { cache: 'no-store' })
    .then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(function (d) {
      const n = Number(d.value != null ? d.value : d.count);
      if (!Number.isFinite(n) || n <= 0) throw new Error('bad payload');
      localStorage.setItem(STORE_FLAG, '1');
      roll(countEl, n);
    })
    .catch(function (err) {
      countEl.textContent = '??';
      countEl.style.opacity = '.6';
      console.warn('[grave] 计数服务不可用：', err);
    });
})();
</script>
</body>
</html>
